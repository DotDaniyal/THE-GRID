# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_USERNAME & ADMIN_PASSCODE (or ADMIN_PASSWORD): Recommended for production / Vercel deployments.
# If ADMIN_USERNAME is omitted when ADMIN_PASSCODE/ADMIN_PASSWORD is set, "admin" or "admin@thegrid.pk" is accepted.
# If left unset in local/VM deployments, an inline first-run admin setup screen lets you create one.
ADMIN_USERNAME=
ADMIN_PASSCODE=
ADMIN_PASSWORD=

# SESSION_SECRET: Recommended 16+ character random string for signing admin session cookies & Bearer tokens.
SESSION_SECRET=

# LOCAL JSON DATA STORAGE (Development / Local Node Server):
# JSON_DATA_DIR: Directory for persistent JSON collections (defaults to ./data).
JSON_DATA_DIR=

# VERCEL PRODUCTION PERSISTENT JSON STORAGE:
# Option A (Recommended): Connected PRIVATE Vercel Blob Store
# Automatically set when you connect a Private Blob store in Vercel Storage -> Blob.
# Set VERCEL_BLOB_ACCESS=private (default) for Private Vercel Blob stores; never expose private JSON via public URLs.
BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_ACCESS=private

# Option B (Alternative / Optional Distributed Slot Lock): Upstash Redis / Vercel KV
# Supports UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN, KV_REST_API_URL + KV_REST_API_TOKEN,
# custom-prefixed *_KV_REST_API_URL/*_UPSTASH_REDIS_REST_URL pairs, or Upstash REDIS_URL / KV_URL.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Optional storage driver routing override: "auto" | "blob" | "redis"
# (Legacy aliases "vercel_blob" and "upstash_redis" are also supported.)
STORAGE_DRIVER=auto

# Legacy SQLite source path used only for initial migration into JSON (defaults to ./database.sqlite)
SQLITE_DB_PATH=
