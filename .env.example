# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_USERNAME & ADMIN_PASSCODE: Recommended for production / Vercel deployments.
# If ADMIN_USERNAME is omitted when ADMIN_PASSCODE is set, "admin" or "admin@thegrid.pk" is accepted.
# If left unset in local/VM deployments, an inline first-run admin setup screen lets you create one.
ADMIN_USERNAME=
ADMIN_PASSCODE=

# SESSION_SECRET: Recommended 16+ character random string for signing admin session cookies & Bearer tokens.
SESSION_SECRET=

# LOCAL JSON DATA STORAGE (Development / Local Node Server):
# JSON_DATA_DIR: Directory for persistent JSON collections (defaults to ./data).
JSON_DATA_DIR=

# VERCEL PRODUCTION PERSISTENT JSON STORAGE:
# Option A (Recommended): Vercel Blob Store (Private Store recommended)
# Automatically set when you connect a Vercel Blob store in Vercel Storage -> Blob.
BLOB_READ_WRITE_TOKEN=
# Optional: "private" (default, recommended) or "public" if using a public Vercel Blob store.
VERCEL_BLOB_ACCESS=private

# Option B (Alternative / Optional Distributed Slot Lock): Upstash Redis / Vercel KV REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional override: "vercel_blob" | "upstash_redis" (auto-detected by environment)
STORAGE_DRIVER=

# Legacy SQLite source path used only for initial migration into JSON (defaults to ./database.sqlite)
SQLITE_DB_PATH=
